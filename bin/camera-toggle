#!/bin/bash
# camera-toggle - swap RelayCam between live sensor and black placeholder.
# No restarts: the supervisor hot-swaps the feed, device never drops.
# LED follows the real sensor only.
if [ "$(cat /tmp/camera-mode 2>/dev/null || echo off)" = "on" ]; then
  echo off > /tmp/camera-mode
  notify-send "camera" "RelayCam placeholder - LED out" 2>/dev/null
else
  echo on > /tmp/camera-mode
  notify-send "camera" "RelayCam LIVE - warming up (~2s)" 2>/dev/null
fi
