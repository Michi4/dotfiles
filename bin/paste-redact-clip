#!/bin/bash
# paste-redact-clip {auto|preview} - clipboard frontend for paste-redact.
#   auto:    clipboard -> redact (+stats footer) -> clipboard, notify summary
#   preview: interactive color preview in a terminal (re-opens itself in foot
#            when launched without tty, e.g. from a sway hotkey), then clipboard
ENGINE=/home/michi/bin/paste-redact
MODE="${1:-preview}"
OUT=/tmp/paste-redact
trap 'rm -f "$IN"' EXIT

if [ "$MODE" = preview ] && [ ! -t 0 ]; then
  exec foot -e "$0" preview
fi

IN=$(mktemp /tmp/paste-redact-in.XXXXXX)
if ! wl-paste > "$IN" 2>/dev/null || [ ! -s "$IN" ]; then
  notify-send "paste-redact" "Kein Text im Clipboard" 2>/dev/null
  exit 1
fi

summary_of() {
  python3 -c "
import json
d = json.load(open('$OUT.report.json'))
print('%s · %.1fs' % (d['summary'], d['stats']['timings'].get('total', 0)))" 2>/dev/null
}

if [ "$MODE" = auto ]; then
  "$ENGINE" --auto --report "$OUT.report.json" < "$IN" > "$OUT.redacted.txt"
  wl-copy < "$OUT.redacted.txt"
  notify-send "paste-redact" "$(summary_of) - im Clipboard" 2>/dev/null
  exit 0
fi

# preview: engine shows color UI on /dev/tty, prints final text to stdout
"$ENGINE" --preview --report "$OUT.report.json" < "$IN" > "$OUT.redacted.txt"
RC=$?
if [ $RC -eq 0 ]; then
  wl-copy < "$OUT.redacted.txt"
  notify-send "paste-redact" "$(summary_of) - übernommen" 2>/dev/null
elif [ $RC -eq 3 ]; then
  wl-copy < "$OUT.redacted.txt"
  notify-send "paste-redact" "Original (ohne Redaction) übernommen" 2>/dev/null
else
  notify-send "paste-redact" "Abgebrochen - Clipboard unverändert" 2>/dev/null
fi
