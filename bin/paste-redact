#!/usr/bin/env python3
"""paste-redact - hybrid secret redactor for pasted text (fully offline).

Pipeline: normalize -> custom regex -> (gitleaks || LLM in parallel) -> redacted text.
Usage:
  paste-redact --auto [--strict] [--slim|--no-slim] [--report PATH] [FILE]   redacted text + stats footer to stdout
  paste-redact --preview [--strict] [--report PATH] [FILE] interactive color preview, final text to stdout (exit 2 = aborted, 3 = original)
  paste-redact --preview-out PREFIX [--strict] [FILE]      write PREFIX.redacted.txt + PREFIX.report.json
  paste-redact --selftest                                  run test corpus, exit 0 iff all pass
Reads stdin when FILE is omitted. Secrets only - hostnames/IPs/paths are kept.
Preview keys: Enter ok, N/#Na/#Nt un-redact, k slim toggle, K slim default speichern,
o original, u ohne Komprimierung, r retry, q Abbruch.
Config ~/.config/paste-redact/config.json holds model, thresholds, slim_default.
"""
import concurrent.futures
import html
import json
import os
import re
import subprocess
import sys
import tempfile
import time
import urllib.request

HOME = os.path.expanduser("~")
CFG_DIR = os.path.join(HOME, ".config", "paste-redact")

TAG_RX = re.compile(r"\[REDACTED_[A-Z0-9-]+\]")
PROMPT_RX = re.compile(r"^\[[^\]]+[@:][^\]]*\][#$] ?(.*)$")

# ANSI colors (preview runs in a terminal)
BOLD = "\x1b[1m"
CYAN = "\x1b[36m"
DIM = "\x1b[2m"
RED = "\x1b[31m"
YEL = "\x1b[43m\x1b[30m"
RST = "\x1b[0m"

SELFTEST_CASES = [
    ("case1_aws_password.txt", 3),
    ("case2_prose_tokens.txt", 2),
    ("case3_key_urlcreds.txt", 2),
    ("case4_fastfetch_negative.txt", 0),
    ("case5_two_prose_passwords.txt", 2),
]


def load_config():
    with open(os.path.join(CFG_DIR, "config.json")) as f:
        return json.load(f)


LLM_PROMPT = """You scan pasted text for secrets to redact. Flag anything that looks like a password, API key, token, or credential - when in doubt, FLAG IT. Missing a secret is worse than flagging an extra candidate.
Do NOT flag: hostnames, domain names, usernames, IP addresses, file paths, version numbers, port numbers, ordinary words, git commit hashes, shell commands with their flags/options/pipes/redirections, plain URLs without credentials, certificate fields (subject/issuer/dates). Ignore anything already masked as [REDACTED_...].
Examples:
TEXT: export KEY="AKIA5F4D3C2B1A987654"
[{"secret": "AKIA5F4D3C2B1A987654", "label": "aws-key"}]
TEXT: server srv-01 port 8080 user admin
[]
TEXT: $ curl -Iv https://example.com 2>&1 | grep subject
[]
TEXT: * subject: CN=host.example.com
[]
Return ONLY a JSON array, no other text. Each item: {"secret": "<exact substring from TEXT>", "label": "<short type>"}.
TEXT:
<<<TEXT>>>
"""

LLM_PROMPT_STRICT = LLM_PROMPT.replace(
    "when in doubt, FLAG IT.",
    "when in doubt, FLAG IT. Be EXTRA aggressive: also flag weak-looking passwords, short tokens, and anything remotely credential-shaped.",
)


def normalize(text):
    text = re.sub(r"\x1b\[[0-9;?]*[a-zA-Z]", "", text)  # ANSI escapes
    text = text.replace("\r\n", "\n").replace("\r", "\n")
    out = []
    prev = None
    first_prompt = True
    for line in text.split("\n"):
        # "[michi@hp835 ~]$ cmd" -> "$ cmd"; the FIRST prompt line is kept
        # verbatim so the machine context survives once, bare prompts -> drop
        m = PROMPT_RX.match(line)
        if m:
            rest = m.group(1).strip()
            if not rest:
                continue
            if first_prompt:
                first_prompt = False
                line = line.rstrip()
            else:
                line = "$ " + rest
        else:
            line = line.rstrip()
        # collapse consecutive duplicates only for prompts/empties (never code)
        if line == prev and (not line or line.startswith("$ ") or PROMPT_RX.match(line)):
            continue
        prev = line
        out.append(line)
    text = "\n".join(out)
    text = re.sub(r"\n{4,}", "\n\n\n", text)
    return text.strip() + "\n" if text.strip() else ""


def overlapping(spans, s, e):
    return any(s < oe and e > os for os, oe in spans)


def dedupe(repls):
    """Drop overlapping spans within one stage, preferring the longest."""
    out = []
    for s, e, label in sorted(repls, key=lambda r: (r[1] - r[0]), reverse=True):
        if not overlapping([(os, oe) for os, oe, _ in out], s, e):
            out.append((s, e, label))
    return out


def apply_all(text, repls, stage, applied):
    """Apply spans right-to-left, tracking exact final (pos, end) per entry.

    All entries in `applied` (old and new) keep correct positions in the
    current text: every replacement shifts entries right of it by its delta.
    Returns the new text; entries are appended to `applied` in place.
    """
    ordered = sorted(repls, key=lambda r: r[0], reverse=True)
    new_entries = []
    for s, e, label in ordered:
        original = text[s:e]
        tag = "[REDACTED_%s]" % re.sub(r"[^A-Z0-9]+", "-", label.upper()).strip("-")
        delta = len(tag) - (e - s)
        text = text[:s] + tag + text[e:]
        for a in applied + new_entries:
            if a["pos"] >= e:
                a["pos"] += delta
                a["end"] += delta
        new_entries.append({"label": label, "tag": tag, "stage": stage,
                            "original": original, "pos": s, "end": s + len(tag)})
    applied.extend(new_entries)
    return text


def tag_spans(text):
    return [(m.start(), m.end()) for m in TAG_RX.finditer(text)]


# High-value token shapes: always on (user custom-patterns.json runs on top).
# These must never depend on LLM luck.
BUILTIN_PATTERNS = [
    ("aws-key", r"\bAKIA[0-9A-Z]{16}\b"),
    ("aws-key", r"\bASIA[0-9A-Z]{16}\b"),
    ("github-token", r"\bgh[oupsr]_[A-Za-z0-9]{36}\b"),
    ("github-token", r"\bgithub_pat_[A-Za-z0-9_]{22,}\b"),
    ("gitlab-token", r"\bglpat-[A-Za-z0-9_\-]{20,}\b"),
    ("slack-token", r"\bxox[baprs]-[A-Za-z0-9\-]{10,}\b"),
    ("openai-key", r"\bsk-[A-Za-z0-9]{20,}\b"),
    ("anthropic-key", r"\bsk-ant-[A-Za-z0-9\-]{10,}\b"),
]


def stage_custom(text, taken):
    patterns = list(json.load(open(os.path.join(CFG_DIR, "custom-patterns.json"))))
    for name, rx in BUILTIN_PATTERNS:
        patterns.append({"name": name, "pattern": rx, "group": 0})
    repls = []
    for p in patterns:
        try:
            rx = re.compile(p["pattern"])
        except re.error as ex:
            print("bad custom pattern %s: %s" % (p.get("name"), ex), file=sys.stderr)
            continue
        for m in rx.finditer(text):
            g = p.get("group", 0)
            try:
                s, e = m.span(g)
            except IndexError:
                continue
            if e > s and not overlapping(taken, s, e):
                repls.append((s, e, p.get("name", "CUSTOM")))
                taken.append((s, e))
    return dedupe(repls)


def stage_gitleaks(text, taken):
    with tempfile.NamedTemporaryFile("w", suffix=".txt", delete=False) as f:
        f.write(text)
        src = f.name
    try:
        p = subprocess.run(
            ["gitleaks", "detect", "--no-git", "--source", src,
             "--report-format", "json", "--report-path", "-", "--exit-code", "0",
             "--no-color"],
            capture_output=True, text=True, timeout=120)
        try:
            findings = json.loads(p.stdout or "[]")
        except json.JSONDecodeError:
            print("gitleaks: unparsable output", file=sys.stderr)
            return []
    finally:
        os.unlink(src)
    lines = text.split("\n")
    repls = []
    for fl in findings:
        secret = fl.get("Secret", "")
        if not secret:
            continue
        try:
            sl, el = max(0, fl["StartLine"] - 1), max(0, fl["EndLine"] - 1)
        except KeyError:
            continue
        seg_start = sum(len(line) + 1 for line in lines[:sl])
        seg_end = sum(len(line) + 1 for line in lines[:el + 1])
        segment = text[seg_start:seg_end]
        idx = 0
        while True:
            idx = segment.find(secret, idx)
            if idx < 0:
                break
            s, e = seg_start + idx, seg_start + idx + len(secret)
            if not overlapping(taken, s, e):
                repls.append((s, e, fl.get("RuleID", "GITLEAKS")))
                taken.append((s, e))
            idx += 1
    return dedupe(repls)


# Shapes that are never secrets (the LLM occasionally flags them anyway,
# e.g. an IP in fastfetch output despite the prompt exclusion) -> veto.
VETO_RX = [
    re.compile(r"^(?:\d{1,3}\.){3}\d{1,3}(/\d{1,2})?$"),          # IPv4 + CIDR
    re.compile(r"^([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}$"),        # MAC
    re.compile(r"^[0-9a-fA-F]{40}$|^[0-9a-fA-F]{64}$"),            # SHA-1 / SHA-256
    re.compile(r"^\d+$"),                                         # bare numbers (log noise, never redact)
    re.compile(r"^\d*>&\d+$"),                                    # shell redirections (2>&1, >&2)
    re.compile(r"^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,}\.?$"),
    # ^ lowercase FQDN/hostname (user keeps hostnames; dotted passwords with
    # uppercase survive this veto by design)
]
# ... and any multi-word span embedding one of these is context, not credential
CONTAINS_VETO_RX = [
    re.compile(r"(?:\d{1,3}\.){3}\d{1,3}"),
    re.compile(r"(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,}\b"),
    re.compile(r"(?:CN|OU|O|L|ST|C|DC|SN|GN|emailAddress)="),  # cert DN attributes
]
# cert subject/issuer attributes are output, never pasted secrets
VETO_RX.append(re.compile(r"^(?:CN|OU|O|L|ST|C|DC|SN|GN|emailAddress)=.*"))
# ticket/order refs are noise for this user (600+ FPs on one paste) - never redact
VETO_RX.append(re.compile(r"^[A-Za-z]+#\d+$"))       # Ticket#732285
VETO_RX.append(re.compile(r"^[A-Z]{2,10}-\d{2,}$"))  # WNC-20237597 (JIRA-style)


def vetoed(secret):
    s = secret.strip()
    if s.lower() in VETO_WORDS:
        return True
    if any(rx.match(s) for rx in VETO_RX):
        return True
    if " " in s and any(rx.search(s) for rx in CONTAINS_VETO_RX):
        return True  # phrase embedding a hostname/IP is context, not credential
    return False


# literal meta-words the model sometimes "quotes" instead of real secrets
VETO_WORDS = {"token", "password", "passwort", "secret", "geheimnis", "key",
              "schlüssel", "schluessel", "kennwort", "hidden", "redacted", "pwd",
              # protocol/tool/field names are never secrets either
              "subject", "issuer", "hostname", "subjectaltname", "certificate",
              "cert", "expire", "expiry", "serial", "curl", "dig", "grep",
              "wget", "ssh", "openssl", "notbefore", "notafter", "fingerprint",
              "cn", "ou", "dc"}


def secret_candidates(secret):
    cands = [secret]
    s = secret.strip()
    if s != secret:
        cands.append(s)
    q = s.strip("\"'`")
    if q != s:
        cands.append(q)
    return cands


# Lines looking like they talk about credentials are never dropped by compaction
# (prose passwords hide there) - they get priority when the input is over budget.
SUSPICIOUS_RX = re.compile(
    r"password|passwd|pwd|passwort|secret|geheim|token|api[-_ ]?key|auth|credential|"
    r"bearer|private[-_ ]?key|zugang",
    re.IGNORECASE)


def compact_for_llm(text, cfg, no_compact=False):
    """Shrink text for the LLM prompt without losing recall.

    Deterministic stages always run on the FULL text; the LLM only needs one
    sighting of each distinct line, so global duplicate lines are dropped and
    very long inputs are middle-truncated. Findings are re-matched against the
    full text afterwards (all occurrences get redacted).
    Returns (compacted, info dict).
    """
    if no_compact:
        over = len(text) > cfg.get("ctx_max", 8192) * 3
        return text, {"input_chars": len(text), "compact_chars": len(text),
                      "dup_lines_removed": 0, "truncated": False,
                      "omitted_chars": 0, "over_ctx": over}
    text = TAG_RX.sub("[hidden]", text)  # already handled: don't let the model fixate on tags
    orig_chars = len(text)
    lines = text.split("\n")
    seen = set()
    kept = []
    dup_lines = 0
    for line in lines:
        s = line.strip()
        if not s:
            if kept and kept[-1] != "":
                kept.append("")
            continue
        if s in seen:
            dup_lines += 1
            continue
        seen.add(s)
        kept.append(line)
    compacted = "\n".join(kept)
    truncated = False
    omitted = 0
    max_chars = cfg.get("max_input_chars", 8000)
    if len(compacted) > max_chars:
        # over budget: keyword-bearing lines first (prose secrets hide there),
        # then head/tail of the rest. Order may shuffle - matching runs on full text.
        n = len(kept)
        is_kw = [bool(SUSPICIOUS_RX.search(line)) for line in kept]
        rest = [i for i in range(n) if not is_kw[i]]
        order = [i for i in range(n) if is_kw[i]] + rest
        parts, used, dropped = [], 0, 0
        for i in order:
            line = kept[i]
            if used + len(line) + 1 <= max_chars:
                parts.append(line)
                used += len(line) + 1
            else:
                dropped += 1
        omitted = len(compacted) - used
        compacted = ("\n".join(parts)
                     + "\n[... %d chars / %d lines omitted ...]\n" % (omitted, dropped))
        truncated = True
    info = {"input_chars": orig_chars, "compact_chars": len(compacted),
            "dup_lines_removed": dup_lines, "truncated": truncated,
            "omitted_chars": omitted}
    return compacted, info


def ctx_for(prompt_chars, cfg):
    """Context size with guaranteed headroom: prompt estimate + prediction + reserve."""
    est_tokens = prompt_chars // 3  # conservative chars-per-token for pastes
    want = est_tokens + cfg.get("num_predict", 300) + cfg.get("ctx_headroom", 256)
    want = max(1024, min(cfg.get("ctx_max", 8192), want))
    return (want + 255) // 256 * 256  # round up to 256


def tok_est(chars):
    return chars // 4


def tok_fmt(chars):
    t = tok_est(chars)
    return "~%dk" % (t // 1000) if t >= 1000 else "%d" % t


def slim_text(text, cfg):
    """Lossy output compaction for LLM chats: fold global duplicate lines
    (first occurrence wins), collapse blanks, enforce a size cap.
    Short structural lines (code braces, bullets, counters) are never folded.
    Returns (slimmed, info dict). Pure function - safe to unit-test.
    """
    min_len = cfg.get("slim_min_len", 24)
    max_chars = cfg.get("slim_max_chars", 20000)
    fuzzy = cfg.get("slim_fuzzy", True)
    in_chars = len(text)
    seen = set()
    out = []
    dup_lines = 0
    blanks = 0
    for raw in text.split("\n"):
        line = raw.rstrip()
        s = line.strip()
        if not s:
            blanks += 1
            if blanks <= 1:
                out.append("")
            continue
        blanks = 0
        if len(s) >= min_len:
            # fuzzy: lines differing only in digits fold too (log counters,
            # timestamps, iterations) - first occurrence wins, original kept
            key = re.sub(r"\d+", "#", s) if fuzzy else s
            if key in seen:
                dup_lines += 1
                continue
            seen.add(key)
        out.append(line)
    slimmed = "\n".join(out)
    capped = False
    if len(slimmed) > max_chars:
        head_len = max_chars * 3 // 4
        slimmed = (slimmed[:head_len]
                   + "\n[... %d Zeichen gekürzt ...]\n" % (len(slimmed) - max_chars)
                   + slimmed[-(max_chars - head_len):])
        capped = True
    if not slimmed.endswith("\n"):
        slimmed += "\n"
    return slimmed, {"slim_in": in_chars, "slim_out": len(slimmed),
                     "slim_dup_lines": dup_lines, "slim_capped": capped}


def query_llm(prompt, model, temp, num_ctx, num_predict, url, keep_alive, timeout):
    """Single /api/generate call. Returns parsed spans list or raises."""
    body = json.dumps({
        "model": model,
        "prompt": prompt,
        "stream": False, "format": "json", "keep_alive": keep_alive,
        "options": {"temperature": temp, "num_ctx": num_ctx, "num_predict": num_predict},
    }).encode()
    req = urllib.request.Request(url + "/api/generate", data=body,
                                 headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        resp = json.loads(r.read().decode())["response"]
    spans = json.loads(resp)
    if isinstance(spans, dict):
        spans = [spans] if "secret" in spans else spans.get("secrets", spans.get("findings", []))
    return spans if isinstance(spans, list) else []


def stage_llm(text, taken, cfg, strict, llm_stats, second=False, no_compact=False):
    if second:  # second opinion: aggressive prompt, same fast model, warmer temp
        prompt_tmpl = LLM_PROMPT_STRICT
        model = cfg["model"]
        base_temp = cfg.get("temperature", 0.2) + 0.2
    elif strict or cfg.get("auto_aggressive", True):
        # recall-first: aggressive prompt everywhere (FPs are one keypress
        # away in preview); --strict additionally escalates the model
        prompt_tmpl = LLM_PROMPT_STRICT
        model = cfg["strict_model"] if strict else cfg["model"]
        base_temp = cfg["strict_temperature"] if strict else cfg["temperature"]
    else:
        prompt_tmpl = LLM_PROMPT
        model = cfg["model"]
        base_temp = cfg.get("temperature", 0.2)
    compacted, cinfo = compact_for_llm(text, cfg, no_compact)
    llm_stats.update(cinfo)
    # long inputs: split into focused chunks, queried in parallel (small models
    # lose recall in long noise). Normal pastes stay a single call.
    chunk_chars = cfg.get("chunk_chars", 4000)
    clines = compacted.split("\n")
    chunks, cur = [], []
    cur_len = 0
    for line in clines:
        if cur and cur_len + len(line) + 1 > chunk_chars:
            chunks.append("\n".join(cur))
            cur, cur_len = [], 0
        cur.append(line)
        cur_len += len(line) + 1
    if cur:
        chunks.append("\n".join(cur))
    llm_stats["chunks"] = len(chunks)
    prompts = [prompt_tmpl.replace("<<<TEXT>>>", c) for c in chunks]
    num_ctx = ctx_for(max(len(p) for p in prompts), cfg)
    llm_stats["num_ctx"] = num_ctx
    spans = []
    attempts = 0
    failed = False

    def run_one(prompt):
        for attempt in range(2):  # one retry with higher temperature
            try:
                return query_llm(prompt, model, base_temp + 0.2 * attempt, num_ctx,
                                 cfg["num_predict"], cfg["ollama_url"],
                                 cfg.get("keep_alive", "15m"), cfg.get("request_timeout", 150)), attempt + 1
            except Exception as ex:
                print("llm attempt %d failed (%s)" % (attempt + 1, ex), file=sys.stderr)
        return None, 2

    with concurrent.futures.ThreadPoolExecutor(max_workers=min(4, len(prompts))) as ex:
        results = list(ex.map(run_one, prompts))
    for res, att in results:
        attempts = max(attempts, att)
        if res is None:
            failed = True
        else:
            spans += res
    llm_stats["attempts"] = attempts
    llm_stats["model"] = model
    if failed and not spans:
        print("llm stage failed - continuing with deterministic results", file=sys.stderr)
        llm_stats["failed"] = True
        return []
    if failed:
        llm_stats["failed"] = True
    return match_spans(spans, text, taken, cfg, llm_stats)


def match_spans(spans, text, taken, cfg, llm_stats):
    """Match LLM-returned secrets against the full text. Returns repls list."""
    repls = []
    max_occ = cfg.get("max_occurrences", 10)
    for item in spans:
        if not isinstance(item, dict):
            continue
        secret = item.get("secret", "")
        label = item.get("label", "LLM") or "LLM"
        if not secret or len(secret) < 3:
            continue
        if vetoed(secret):
            continue
        matched = False
        for cand in secret_candidates(secret):
            if len(cand) < 3 or vetoed(cand):
                continue
            hits = []
            idx = 0
            while True:
                idx = text.find(cand, idx)
                if idx < 0:
                    break
                e = idx + len(cand)
                if not overlapping(taken, idx, e):
                    hits.append((idx, e))
                idx += 1
            if not hits:
                continue
            if len(hits) > max_occ:
                # a "secret" occurring that often is log noise, not a secret
                llm_stats.setdefault("capped", []).append(cand[:60])
                matched = True
                break
            for idx, e in hits:
                repls.append((idx, e, str(label)))
                taken.append((idx, e))
            matched = True
            break
        if not matched:
            llm_stats["unmatched"].append(secret[:60])
    return dedupe(repls)


def redact(text, cfg, strict=False, no_compact=False):
    """Returns (redacted_text, applied, stats). applied entries hold label/tag/stage/original."""
    stats = {"strict": strict, "stages": {}, "timings": {},
             "llm": {"attempts": 0, "model": cfg["strict_model"] if strict else cfg["model"],
                     "failed": False, "unmatched": []}}
    t_all = time.perf_counter()
    text = normalize(text)
    if not text:
        stats["timings"]["total"] = 0.0
        return "", [], stats

    # custom regex first (fast, sync) - its tags are visible to the next stages
    taken = []
    t0 = time.perf_counter()
    c_repls = stage_custom(text, taken)
    stats["timings"]["custom"] = time.perf_counter() - t0
    text = apply_all(text, c_repls, "regex", applied := [])
    taken = tag_spans(text)
    stats["stages"]["regex"] = len(applied)

    # gitleaks and LLM overlap in wall-clock time on the same tagged text
    t0 = time.perf_counter()
    with concurrent.futures.ThreadPoolExecutor(max_workers=2) as ex:
        fg = ex.submit(stage_gitleaks, text, list(taken))
        fl = ex.submit(stage_llm, text, list(taken), cfg, strict, stats["llm"],
                       False, no_compact)
        g_repls = fg.result()
        l_repls = fl.result()
    stats["timings"]["detect_parallel"] = time.perf_counter() - t0

    g_repls = [(s, e, lb) for s, e, lb in g_repls if not overlapping(taken, s, e)]
    n0 = len(applied)
    text = apply_all(text, g_repls, "gitleaks", applied)
    taken = tag_spans(text)
    stats["stages"]["gitleaks"] = len(applied) - n0

    l_repls = [(s, e, lb) for s, e, lb in l_repls if not overlapping(taken, s, e)]
    n0 = len(applied)
    text = apply_all(text, l_repls, "llm", applied)
    taken = tag_spans(text)
    stats["stages"]["llm"] = len(applied) - n0
    stats["llm"]["passes"] = 1

    # second opinion: secrets were found AND untagged lines still talk about
    # credentials (small models drop findings when several secrets are present).
    # Full re-scan only pays off for single-chunk inputs; big inputs get the
    # cheaper micro-focus below instead.
    if (cfg.get("llm_second_pass", True) and stats["llm"].get("chunks", 1) == 1
            and applied):
        untagged = "\n".join(l for l in text.split("\n") if "[REDACTED_" not in l)
        if SUSPICIOUS_RX.search(untagged):
            t0 = time.perf_counter()
            l2 = stage_llm(text, list(taken), cfg, strict, stats["llm"], second=True,
                           no_compact=no_compact)
            stats["timings"]["llm_pass2"] = time.perf_counter() - t0
            l2 = [(s, e, lb) for s, e, lb in l2 if not overlapping(taken, s, e)]
            n0 = len(applied)
            text = apply_all(text, l2, "llm2", applied)
            stats["stages"]["llm2"] = len(applied) - n0
            stats["llm"]["passes"] = 2

    # micro-focus: lines with MORE credential keywords than already-redacted
    # tags get their own tiny query each (measured: the model reliably flags a
    # secret in isolation that it drops inside long noise - including a second
    # secret sharing a line with the first). Handled spans are blanked (tags
    # get echoed, placeholder words get flagged - empty masks neither).
    # Capped, parallel, cheap.
    if cfg.get("llm_micro_focus", True):
        fulllines = text.split("\n")
        targets = []
        for i, l in enumerate(fulllines):
            stripped = TAG_RX.sub("", l)  # ignore keywords inside tags (BEARER/TOKEN/...)
            if len(SUSPICIOUS_RX.findall(stripped)) > len(TAG_RX.findall(l)):
                targets.append(i)
        targets = targets[:10]
        if targets:
            t0 = time.perf_counter()
            blanked = TAG_RX.sub("[hidden]", text).split("\n")
            micro_prompts = []
            for i in targets:
                win = blanked[max(0, i - 1):i + 2]
                micro_prompts.append(LLM_PROMPT_STRICT.replace("<<<TEXT>>>", "\n".join(win)))
            m_ctx = ctx_for(max(len(p) for p in micro_prompts), cfg)
            model = cfg["model"]

            def run_micro(prompt):
                try:
                    return query_llm(prompt, model, cfg.get("temperature", 0.2) + 0.1, m_ctx,
                                     cfg["num_predict"], cfg["ollama_url"],
                                     cfg.get("keep_alive", "15m"),
                                     cfg.get("request_timeout", 150))
                except Exception as ex:
                    print("llm micro query failed (%s)" % ex, file=sys.stderr)
                    return []

            with concurrent.futures.ThreadPoolExecutor(max_workers=min(4, len(micro_prompts))) as ex:
                m_results = list(ex.map(run_micro, micro_prompts))
            m_spans = []
            for r in m_results:
                if isinstance(r, list):
                    m_spans += r
            stats["llm"]["micro_queries"] = len(micro_prompts)
            taken = tag_spans(text)  # refresh: pass-2 tags included
            # NOTE: no post-filter here - match_spans already validated each
            # span against taken (filtering again would self-overlap and drop all)
            m_repls = match_spans(m_spans, text, taken, cfg, stats["llm"])
            n0 = len(applied)
            text = apply_all(text, m_repls, "llm-micro", applied)
            taken = tag_spans(text)
            stats["stages"]["llm-micro"] = len(applied) - n0
            stats["timings"]["llm_micro"] = time.perf_counter() - t0

    stats["timings"]["total"] = time.perf_counter() - t_all
    return text, applied, stats


def slim_suffix(sinfo):
    if not sinfo:
        return ""
    pct = round((1 - sinfo["slim_out"] / max(1, sinfo["slim_in"])) * 100)
    return " · slim −%d%% (%s→%s tok)" % (
        pct, tok_fmt(sinfo["slim_in"]), tok_fmt(sinfo["slim_out"]))


def summarize(applied, stats, sinfo=None):
    counts = {}
    for a in applied:
        counts[a["label"]] = counts.get(a["label"], 0) + 1
    total = stats["timings"].get("total", 0.0)
    li = stats.get("llm", {})
    inp, outc = li.get("input_chars", 0), li.get("compact_chars", 0)
    comp = (" · llm-input %d→%d (−%d%%)" % (inp, outc, round((1 - outc / inp) * 100))
            if inp else "")
    stages = stats.get("stages", {})
    names = {"regex": "regex", "gitleaks": "gitleaks", "llm": "llm",
             "llm2": "llm2", "llm-micro": "micro"}
    hits = "+".join("%s%d" % (names.get(k, k), v) for k, v in stages.items() if v)
    stage_part = (" · " + hits) if hits else ""
    if not applied:
        summary = "clean (nothing redacted)"
        footer = "[paste-redact · clean · %.1fs%s%s]" % (total, comp, slim_suffix(sinfo))
    else:
        labels = ", ".join(sorted(counts))
        summary = "%d replacement%s (%s)" % (
            len(applied), "" if len(applied) == 1 else "s",
            ", ".join("%s x%d" % (k, v) for k, v in sorted(counts.items())))
        footer = "[paste-redact · %d× redacted: %s · %s · %.1fs%s%s%s]" % (
            len(applied), labels, li.get("model", "?"), total, comp, stage_part,
            slim_suffix(sinfo))
    return summary, footer, counts


def highlight(text):
    return TAG_RX.sub(lambda m: YEL + m.group(0) + RST, text)


def prompt_tty(question):
    try:
        with open("/dev/tty", "r") as tty:
            sys.stderr.write(question)
            sys.stderr.flush()
            return tty.readline().strip()  # case preserved (k vs K differ!)
    except OSError:
        return ""  # no terminal: accept


def save_slim_default(value):
    """Persist slim on/off as the default in config.json."""
    p = os.path.join(CFG_DIR, "config.json")
    try:
        with open(p) as f:
            cfg = json.load(f)
        cfg["slim_default"] = bool(value)
        tmp = p + ".tmp"
        with open(tmp, "w") as f:
            json.dump(cfg, f, indent=2)
        os.replace(tmp, p)
        print("slim-Standard gespeichert: %s" % ("an" if value else "aus"), file=sys.stderr)
    except OSError as ex:
        print("konnte Standard nicht speichern: %s" % ex, file=sys.stderr)


def run_preview(raw, cfg, strict=False, no_compact=False):
    if not raw.strip():
        print("paste-redact: empty input", file=sys.stderr)
        return None, [], {"timings": {}}, 1
    real_stdout = sys.stdout
    sys.stdout = sys.stderr  # UI -> terminal; only the final text uses real stdout
    try:
        return _run_preview_ui(raw, cfg, strict, no_compact)
    finally:
        sys.stdout = real_stdout


def build_meta(redacted, applied):
    """Map LTR tag occurrences to applied entries by exact (pos, end).

    apply_all tracks final positions for every entry, so this mapping is
    exact - even for same-tag/distinct-original across stages.
    """
    by_pos = {(a["pos"], a["end"]): a for a in applied}
    meta = []
    for n, m in enumerate(TAG_RX.finditer(redacted), 1):
        a = by_pos.get((m.start(), m.end()))
        if a is not None:
            meta.append({"n": n, "pos": m.start(), "end": m.end(), "tag": a["tag"],
                         "label": a["label"], "stage": a["stage"], "original": a["original"]})
        else:
            meta.append({"n": n, "pos": m.start(), "end": m.end(), "tag": m.group(0),
                         "label": "?", "stage": "?", "original": None})
    return meta


def render_preview(cur_text, meta, reverted, summary, stats, sinfo=None):
    print("%s%spaste-redact Vorschau · %s%s" % (BOLD, CYAN, summary, RST))
    print("=" * 64)
    print(highlight(cur_text).rstrip("\n"))
    print("=" * 64)
    if meta:
        print("%sErsetzungen:%s" % (BOLD, RST))
        for m in meta:
            free = m["n"] in reverted
            orig = (m["original"] or m["tag"])[:100]
            state = "frei " if free else "     "
            print("  %s%s#%d %s [%s]%s → %s%s%s" % (
                DIM, state, m["n"], m["label"], m["stage"], RST,
                DIM if free else RED, orig, RST))
    else:
        print("%sKeine Secrets gefunden.%s" % (DIM, RST))
    print("-" * 64)
    li = stats["llm"]
    inp, out = li.get("input_chars", 0), li.get("compact_chars", 0)
    if inp > 0:
        saved = 1 - out / inp
        comp_part = "LLM-Input %d→%d (−%d%%)" % (inp, out, round(saved * 100))
    else:
        comp_part = "LLM-Input –"
    parts = ["%d Fundstellen%s" % (len(meta), " (%d freigegeben)" % len(reverted) if reverted else ""),
             "%.1fs" % stats["timings"].get("total", 0), li["model"],
             "ctx %d" % li.get("num_ctx", 0), comp_part,
             "%d Dup-Zeilen" % li.get("dup_lines_removed", 0)]
    if li.get("truncated"):
        parts.append("gekürzt")
    if li.get("chunks", 1) > 1:
        parts.append("%d Chunks" % li["chunks"])
    if li.get("passes", 1) > 1:
        parts.append("2. Meinung")
    if li.get("micro_queries"):
        parts.append("%d Micro" % li["micro_queries"])
    if sinfo is not None:
        parts.append("Slim %d→%d (−%d%%)" % (
            sinfo["slim_in"], sinfo["slim_out"],
            round((1 - sinfo["slim_out"] / max(1, sinfo["slim_in"])) * 100)))
    print("%sStats: %s%s" % (DIM, " · ".join(parts), RST))


def apply_reverts(redacted, meta, reverted):
    cur = redacted
    for m in sorted((x for x in meta if x["n"] in reverted and x["original"] is not None),
                    key=lambda x: x["pos"], reverse=True):
        cur = cur[:m["pos"]] + m["original"] + cur[m["end"]:]
    return cur


def _run_preview_ui(raw, cfg, strict=False, no_compact=False):
    normalized = normalize(raw)
    if not normalized.strip():
        print("paste-redact: empty input", file=sys.stderr)
        return None, [], {"timings": {}}, 1
    last = (normalized, [], {"timings": {}, "llm": {"model": cfg["model"]}}, 0)
    slim_on = bool(cfg.get("slim_default", False))
    for rnd in (1, 2, 3):
        redacted, applied, stats = redact(raw, cfg, strict, no_compact)
        meta = build_meta(redacted, applied)
        reverted = set()
        while True:
            active = [m for m in meta if m["n"] not in reverted]
            cur = apply_reverts(redacted, meta, reverted)
            sinfo = None
            if slim_on:
                cur, sinfo = slim_text(cur, cfg)
            summary, footer, _c = summarize(
                [{"label": m["label"]} for m in active], stats, sinfo)
            if reverted:
                footer += " · %d Stelle(n) freigegeben" % len(reverted)
            render_preview(cur, meta, reverted, summary, stats, sinfo)
            last = (cur, [{"label": m["label"], "tag": m["tag"], "stage": m["stage"]}
                          for m in active], stats, 0)
            slim_label = "an" if slim_on else "aus"
            choice = prompt_tty("[↵] Passt   [1] #1 frei   [1a] #1 alle gleich   "
                                "[1t] #1 alle vom Typ   [k] Kompakt:%s (K=speichern)   "
                                "[o] Original   [u] ohne Kompr.   [r] Retry   [q] Abbruch: "
                                % slim_label)
            cl = choice.lower()
            if cl in ("", "y", "j", "p"):
                if reverted:
                    print("paste-redact: " + footer, file=sys.stderr)
                return cur, last[1], stats, 0
            if cl == "o":
                return normalized, [], stats, 3
            if choice == "K":
                slim_on = not slim_on
                save_slim_default(slim_on)
                continue
            if cl == "k":
                slim_on = not slim_on
                continue
            if cl == "u":
                no_compact = True
                break
            if cl.startswith("r"):
                strict = True
                break
            m = (re.match(r"^(\d+)\s*([a-z]*)\s*$", cl)
                 or re.match(r"^([at])\s*(\d+)\s*$", cl))
            if m:
                if m.group(1).isdigit():
                    n, flags = int(m.group(1)), (m.group(2) or "")
                else:
                    flags, n = m.group(1), int(m.group(2))
                entry = next((x for x in meta if x["n"] == n), None)
                if entry is None or entry["original"] is None:
                    print("unbekannte Nummer (1..%d)" % len(meta), file=sys.stderr)
                    continue
                if "a" in flags:
                    for x in meta:
                        if x["original"] == entry["original"]:
                            reverted.add(x["n"])
                elif "t" in flags:
                    for x in meta:
                        if x["label"] == entry["label"]:
                            reverted.add(x["n"])
                elif flags == "":
                    reverted.add(n)
                else:
                    print("unbekannter Zusatz '%s' (nur a/t)" % flags, file=sys.stderr)
                    continue
                continue
            if cl == "q":
                return None, last[1], stats, 2
            print("Format: <Nummer>[a|t], z.B. 1, 1a, 1t - oder k, o, u, r, q, Enter",
                  file=sys.stderr)
    cur, appl, stats, _rc = last
    return cur, appl, stats, 0


def run_selftest(cfg):
    cfg = dict(cfg)
    cfg["temperature"] = 0.0  # deterministic: tests must not flake
    cfg["strict_temperature"] = 0.0
    # pure compaction checks (no LLM involved)
    dup = "line A\nline B\nline A\n\n\nline B\nline C\n"
    comp, info = compact_for_llm(dup, cfg)
    assert comp == "line A\nline B\n\nline C\n", repr(comp)
    assert info["dup_lines_removed"] == 2, info
    big = "secret BerrySecret123!\n" + "".join("noise filler line %d abcdef\n" % i for i in range(3000))
    comp, info = compact_for_llm(big, cfg)
    assert info["truncated"] and "omitted" in comp, info
    assert "secret BerrySecret123!" in comp  # head survives truncation
    # keyword line buried in the middle must survive (prose-secret recall)
    mid = "".join("filler %d\n" % i for i in range(500))
    mid += "the backup password is HiddenMid77!\n"
    mid += "".join("filler %d\n" % i for i in range(500, 1500))
    comp, info = compact_for_llm(mid, cfg)
    assert info["truncated"] and "HiddenMid77" in comp, info
    print("PASS compaction (dupes + truncation + keyword priority)")
    # hostname/IP veto (domains/hostnames/IPs are never secrets)
    for h in ("rottag.com", "kenobi.irretio.at", "srv-web-03.example.org", "192.168.1.1"):
        assert vetoed(h), h
    for s in ("Sommer2024!feld", "ghp_9f8e7d6c5b4a32109f8e", "My.Secret"):
        assert not vetoed(s), s
    # ticket/order references are intentionally vetoed (user: pure noise)
    for t in ("Ticket#732285", "WNC-20237597", "Issue#123"):
        assert vetoed(t), t
    print("PASS veto (hostnames/IPs/tickets blocked, passwords pass)")
    # first shell prompt keeps machine context once, later ones collapse
    n = normalize("[michi@hp835 ~]$ echo hi\n[michi@hp835 ~]$ echo yo\n")
    assert n.startswith("[michi@hp835 ~]$ echo hi\n$ echo yo"), repr(n)
    print("PASS normalize (first prompt verbatim)")
    # slim output compaction (pure function)
    t = ("error: connection timeout after 30s retrying host db-01\n" * 3
         + "}\n" * 3 + "\n\n\n" + "unique line here ok\n")
    s, info = slim_text(t, cfg)
    assert info["slim_dup_lines"] == 2, info
    assert s.count("}") == 3, repr(s)  # short structural lines survive
    assert "\n\n\n" not in s and "unique line here ok" in s
    s2, info2 = slim_text("x" * 25000, cfg)
    assert info2["slim_capped"] and "gekürzt" in s2, info2
    fz = ("backup job 1 finished in 12s ok\n" * 1 + "backup job 2 finished in 34s ok\n"
          + "short\n")
    sf, infof = slim_text(fz, cfg)
    assert infof["slim_dup_lines"] == 1 and "job 1" in sf, (sf, infof)
    print("PASS slim (dup-fold, blanks, cap)")
    testdir = os.path.join(CFG_DIR, "tests")
    ok = True
    for name, expected in SELFTEST_CASES:
        with open(os.path.join(testdir, name)) as f:
            raw = f.read()
        t0 = time.perf_counter()
        _red, applied, _stats = redact(raw, cfg, strict=False)
        dt = time.perf_counter() - t0
        good = len(applied) == expected
        ok = ok and good
        print("%s %-28s expected %d, got %d (%.1fs)" % (
            "PASS" if good else "FAIL", name, expected, len(applied), dt))
    print("selftest: " + ("ALL PASS" if ok else "FAILURES"))
    return 0 if ok else 1


def main():
    args = sys.argv[1:]
    strict = "--strict" in args
    no_compact = "--no-compact" in args
    want_slim = "--slim" in args
    want_stats = "--stats" in args or "--auto" in args
    want_preview = "--preview" in args
    want_selftest = "--selftest" in args
    args = [a for a in args if a not in ("--strict", "--auto", "--preview", "--stats",
                                         "--selftest", "--no-compact", "--slim", "--no-slim")]
    cfg = load_config()
    if "--no-slim" not in sys.argv[1:]:
        want_slim = want_slim or bool(cfg.get("slim_default", False))

    if want_selftest:
        sys.exit(run_selftest(cfg))

    report_path = None
    if "--report" in args:
        i = args.index("--report")
        report_path = args[i + 1]
        args = args[:i] + args[i + 2:]
    preview_out = None
    if "--preview-out" in args:
        i = args.index("--preview-out")
        preview_out = args[i + 1]
        args = args[:i] + args[i + 2:]

    if args and not args[0].startswith("-"):
        with open(args[0]) as f:
            raw = f.read()
    else:
        raw = sys.stdin.read()

    if want_preview:
        redacted, applied, stats, rc = run_preview(raw, cfg, strict, no_compact)
        if redacted is None:
            print("paste-redact: preview ended without result", file=sys.stderr)
            sys.exit(rc)
        sys.stdout.write(redacted)
        if rc == 3:
            summary, footer = "Original ohne Redaction übernommen", ""
        else:
            summary, footer, _c = summarize(applied, stats)
        if report_path:
            write_report_json(report_path, summary, footer, applied, stats)
        print("paste-redact: " + summary, file=sys.stderr)
        sys.exit(rc)

    redacted, applied, stats = redact(raw, cfg, strict, no_compact)
    sinfo = None
    if want_slim:
        redacted, sinfo = slim_text(redacted, cfg)
        stats["slim"] = sinfo
    summary, footer, _counts = summarize(applied, stats, sinfo)
    out = redacted + ("\n" + footer + "\n" if want_stats and redacted else (footer + "\n" if want_stats else ""))

    if preview_out:
        write_private(preview_out + ".redacted.txt", redacted)
        write_report_json(preview_out + ".report.json", summary, footer, applied, stats)
        print(preview_out, flush=True)
    else:
        sys.stdout.write(out)
    if report_path:
        write_report_json(report_path, summary, footer, applied, stats)
    print("paste-redact: " + summary, file=sys.stderr)


def write_private(path, data):
    """Write files that may contain secrets with 0600 (no group/other read)."""
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        with os.fdopen(fd, "w") as f:
            f.write(data)
    except BaseException:
        os.close(fd)
        raise


def write_report_json(path, summary, footer, applied, stats):
    write_private(path, json.dumps({"summary": summary, "footer": footer, "count": len(applied),
                   "replacements": [{"label": a["label"], "tag": a["tag"], "stage": a["stage"],
                                      "original": a.get("original", "")[:200]}
                                    for a in applied],
                   "stats": stats}))


if __name__ == "__main__":
    main()
