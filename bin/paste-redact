#!/usr/bin/env python3
"""paste-redact - hybrid secret redactor for pasted text (fully offline).

Pipeline: normalize -> custom regex -> (gitleaks || LLM in parallel) -> redacted text.
Usage:
  paste-redact --auto [--strict] [--report PATH] [FILE]   redacted text + stats footer to stdout
  paste-redact --preview [--strict] [--report PATH] [FILE] interactive color preview, final text to stdout (exit 2 = aborted)
  paste-redact --preview-out PREFIX [--strict] [FILE]      write PREFIX.redacted.txt + PREFIX.report.json
  paste-redact --selftest                                  run test corpus, exit 0 iff all pass
Reads stdin when FILE is omitted. Secrets only - hostnames/IPs/paths are kept.
"""
import concurrent.futures
import html
import json
import os
import re
import subprocess
import sys
import tempfile
import time
import urllib.request

HOME = os.path.expanduser("~")
CFG_DIR = os.path.join(HOME, ".config", "paste-redact")

TAG_RX = re.compile(r"\[REDACTED_[A-Z0-9-]+\]")
PROMPT_RX = re.compile(r"^\[[^\]]+[@:][^\]]*\][#$] ?(.*)$")

# ANSI colors (preview runs in a terminal)
BOLD = "\x1b[1m"
CYAN = "\x1b[36m"
DIM = "\x1b[2m"
RED = "\x1b[31m"
YEL = "\x1b[43m\x1b[30m"
RST = "\x1b[0m"

SELFTEST_CASES = [
    ("case1_aws_password.txt", 3),
    ("case2_prose_tokens.txt", 2),
    ("case3_key_urlcreds.txt", 2),
    ("case4_fastfetch_negative.txt", 0),
    ("case5_two_prose_passwords.txt", 2),
]


def load_config():
    with open(os.path.join(CFG_DIR, "config.json")) as f:
        return json.load(f)


LLM_PROMPT = """You scan pasted text for secrets to redact. Flag anything that looks like a password, API key, token, or credential - when in doubt, FLAG IT. Missing a secret is worse than flagging an extra candidate.
Do NOT flag: hostnames, usernames, IP addresses, file paths, version numbers, port numbers, ordinary words, git commit hashes. Ignore anything already masked as [REDACTED_...].
Examples:
TEXT: export KEY="AKIA5F4D3C2B1A987654"
[{"secret": "AKIA5F4D3C2B1A987654", "label": "aws-key"}]
TEXT: server srv-01 port 8080 user admin
[]
Return ONLY a JSON array, no other text. Each item: {"secret": "<exact substring from TEXT>", "label": "<short type>"}.
TEXT:
<<<TEXT>>>
"""

LLM_PROMPT_STRICT = LLM_PROMPT.replace(
    "when in doubt, FLAG IT.",
    "when in doubt, FLAG IT. Be EXTRA aggressive: also flag weak-looking passwords, short tokens, and anything remotely credential-shaped.",
)


def normalize(text):
    text = re.sub(r"\x1b\[[0-9;?]*[a-zA-Z]", "", text)  # ANSI escapes
    text = text.replace("\r\n", "\n").replace("\r", "\n")
    out = []
    prev = None
    for line in text.split("\n"):
        # "[michi@hp835 ~]$ cmd" -> "$ cmd"; bare "....$ " prompt lines -> drop
        m = PROMPT_RX.match(line)
        if m:
            rest = m.group(1).strip()
            if not rest:
                continue
            line = "$ " + rest
        line = line.rstrip()
        # collapse consecutive duplicates only for prompts/empties (never code)
        if line == prev and (not line or line.startswith("$ ") or PROMPT_RX.match(line)):
            continue
        prev = line
        out.append(line)
    text = "\n".join(out)
    text = re.sub(r"\n{4,}", "\n\n\n", text)
    return text.strip() + "\n" if text.strip() else ""


def overlapping(spans, s, e):
    return any(s < oe and e > os for os, oe in spans)


def dedupe(repls):
    """Drop overlapping spans within one stage, preferring the longest."""
    out = []
    for s, e, label in sorted(repls, key=lambda r: (r[1] - r[0]), reverse=True):
        if not overlapping([(os, oe) for os, oe, _ in out], s, e):
            out.append((s, e, label))
    return out


def apply_all(text, repls, stage):
    """repls: list of (start, end, label). Returns (new_text, applied entries)."""
    ordered = sorted(repls, key=lambda r: r[0], reverse=True)
    applied = []
    for s, e, label in ordered:
        original = text[s:e]
        tag = "[REDACTED_%s]" % re.sub(r"[^A-Z0-9]+", "-", label.upper()).strip("-")
        text = text[:s] + tag + text[e:]
        applied.append({"label": label, "tag": tag, "stage": stage, "original": original})
    return text, applied


def tag_spans(text):
    return [(m.start(), m.end()) for m in TAG_RX.finditer(text)]


# High-value token shapes: always on (user custom-patterns.json runs on top).
# These must never depend on LLM luck.
BUILTIN_PATTERNS = [
    ("aws-key", r"\bAKIA[0-9A-Z]{16}\b"),
    ("aws-key", r"\bASIA[0-9A-Z]{16}\b"),
    ("github-token", r"\bgh[oupsr]_[A-Za-z0-9]{36}\b"),
    ("github-token", r"\bgithub_pat_[A-Za-z0-9_]{22,}\b"),
    ("gitlab-token", r"\bglpat-[A-Za-z0-9_\-]{20,}\b"),
    ("slack-token", r"\bxox[baprs]-[A-Za-z0-9\-]{10,}\b"),
    ("openai-key", r"\bsk-[A-Za-z0-9]{20,}\b"),
    ("anthropic-key", r"\bsk-ant-[A-Za-z0-9\-]{10,}\b"),
]


def stage_custom(text, taken):
    patterns = list(json.load(open(os.path.join(CFG_DIR, "custom-patterns.json"))))
    for name, rx in BUILTIN_PATTERNS:
        patterns.append({"name": name, "pattern": rx, "group": 0})
    repls = []
    for p in patterns:
        try:
            rx = re.compile(p["pattern"])
        except re.error as ex:
            print("bad custom pattern %s: %s" % (p.get("name"), ex), file=sys.stderr)
            continue
        for m in rx.finditer(text):
            g = p.get("group", 0)
            try:
                s, e = m.span(g)
            except IndexError:
                continue
            if e > s and not overlapping(taken, s, e):
                repls.append((s, e, p.get("name", "CUSTOM")))
                taken.append((s, e))
    return dedupe(repls)


def stage_gitleaks(text, taken):
    with tempfile.NamedTemporaryFile("w", suffix=".txt", delete=False) as f:
        f.write(text)
        src = f.name
    try:
        p = subprocess.run(
            ["gitleaks", "detect", "--no-git", "--source", src,
             "--report-format", "json", "--report-path", "-", "--exit-code", "0",
             "--no-color"],
            capture_output=True, text=True, timeout=120)
        try:
            findings = json.loads(p.stdout or "[]")
        except json.JSONDecodeError:
            print("gitleaks: unparsable output", file=sys.stderr)
            return []
    finally:
        os.unlink(src)
    lines = text.split("\n")
    repls = []
    for fl in findings:
        secret = fl.get("Secret", "")
        if not secret:
            continue
        try:
            sl, el = max(0, fl["StartLine"] - 1), max(0, fl["EndLine"] - 1)
        except KeyError:
            continue
        seg_start = sum(len(line) + 1 for line in lines[:sl])
        seg_end = sum(len(line) + 1 for line in lines[:el + 1])
        segment = text[seg_start:seg_end]
        idx = 0
        while True:
            idx = segment.find(secret, idx)
            if idx < 0:
                break
            s, e = seg_start + idx, seg_start + idx + len(secret)
            if not overlapping(taken, s, e):
                repls.append((s, e, fl.get("RuleID", "GITLEAKS")))
                taken.append((s, e))
            idx += 1
    return dedupe(repls)


# Shapes that are never secrets (the LLM occasionally flags them anyway,
# e.g. an IP in fastfetch output despite the prompt exclusion) -> veto.
VETO_RX = [
    re.compile(r"^(?:\d{1,3}\.){3}\d{1,3}(/\d{1,2})?$"),          # IPv4 + CIDR
    re.compile(r"^([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}$"),        # MAC
    re.compile(r"^[0-9a-fA-F]{40}$|^[0-9a-fA-F]{64}$"),            # SHA-1 / SHA-256
    re.compile(r"^\d+$"),                                         # bare numbers (log noise, never redact)
]


def vetoed(secret):
    s = secret.strip()
    if s.lower() in VETO_WORDS:
        return True
    return any(rx.match(s) for rx in VETO_RX)


# literal meta-words the model sometimes "quotes" instead of real secrets
VETO_WORDS = {"token", "password", "passwort", "secret", "geheimnis", "key",
              "schlüssel", "schluessel", "kennwort", "hidden", "redacted", "pwd"}


def secret_candidates(secret):
    cands = [secret]
    s = secret.strip()
    if s != secret:
        cands.append(s)
    q = s.strip("\"'`")
    if q != s:
        cands.append(q)
    return cands


# Lines looking like they talk about credentials are never dropped by compaction
# (prose passwords hide there) - they get priority when the input is over budget.
SUSPICIOUS_RX = re.compile(
    r"password|passwd|pwd|passwort|secret|geheim|token|api[-_ ]?key|auth|credential|"
    r"bearer|private[-_ ]?key|zugang",
    re.IGNORECASE)


def compact_for_llm(text, cfg):
    """Shrink text for the LLM prompt without losing recall.

    Deterministic stages always run on the FULL text; the LLM only needs one
    sighting of each distinct line, so global duplicate lines are dropped and
    very long inputs are middle-truncated. Findings are re-matched against the
    full text afterwards (all occurrences get redacted).
    Returns (compacted, info dict).
    """
    text = TAG_RX.sub("[hidden]", text)  # already handled: don't let the model fixate on tags
    orig_chars = len(text)
    lines = text.split("\n")
    seen = set()
    kept = []
    dup_lines = 0
    for line in lines:
        s = line.strip()
        if not s:
            if kept and kept[-1] != "":
                kept.append("")
            continue
        if s in seen:
            dup_lines += 1
            continue
        seen.add(s)
        kept.append(line)
    compacted = "\n".join(kept)
    truncated = False
    omitted = 0
    max_chars = cfg.get("max_input_chars", 8000)
    if len(compacted) > max_chars:
        # over budget: keyword-bearing lines first (prose secrets hide there),
        # then head/tail of the rest. Order may shuffle - matching runs on full text.
        n = len(kept)
        is_kw = [bool(SUSPICIOUS_RX.search(line)) for line in kept]
        rest = [i for i in range(n) if not is_kw[i]]
        order = [i for i in range(n) if is_kw[i]] + rest
        parts, used, dropped = [], 0, 0
        for i in order:
            line = kept[i]
            if used + len(line) + 1 <= max_chars:
                parts.append(line)
                used += len(line) + 1
            else:
                dropped += 1
        omitted = len(compacted) - used
        compacted = ("\n".join(parts)
                     + "\n[... %d chars / %d lines omitted ...]\n" % (omitted, dropped))
        truncated = True
    info = {"input_chars": orig_chars, "compact_chars": len(compacted),
            "dup_lines_removed": dup_lines, "truncated": truncated,
            "omitted_chars": omitted}
    return compacted, info


def ctx_for(prompt_chars, cfg):
    """Context size with guaranteed headroom: prompt estimate + prediction + reserve."""
    est_tokens = prompt_chars // 3  # conservative chars-per-token for pastes
    want = est_tokens + cfg.get("num_predict", 300) + cfg.get("ctx_headroom", 256)
    want = max(1024, min(cfg.get("ctx_max", 8192), want))
    return (want + 255) // 256 * 256  # round up to 256


def query_llm(prompt, model, temp, num_ctx, num_predict, url, keep_alive, timeout):
    """Single /api/generate call. Returns parsed spans list or raises."""
    body = json.dumps({
        "model": model,
        "prompt": prompt,
        "stream": False, "format": "json", "keep_alive": keep_alive,
        "options": {"temperature": temp, "num_ctx": num_ctx, "num_predict": num_predict},
    }).encode()
    req = urllib.request.Request(url + "/api/generate", data=body,
                                 headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        resp = json.loads(r.read().decode())["response"]
    spans = json.loads(resp)
    if isinstance(spans, dict):
        spans = [spans] if "secret" in spans else spans.get("secrets", spans.get("findings", []))
    return spans if isinstance(spans, list) else []


def stage_llm(text, taken, cfg, strict, llm_stats, second=False):
    if second:  # second opinion: aggressive prompt, same fast model, warmer temp
        prompt_tmpl = LLM_PROMPT_STRICT
        model = cfg["model"]
        base_temp = cfg.get("temperature", 0.2) + 0.2
    else:
        prompt_tmpl = LLM_PROMPT_STRICT if strict else LLM_PROMPT
        model = cfg["strict_model"] if strict else cfg["model"]
        base_temp = cfg["strict_temperature"] if strict else cfg["temperature"]
    compacted, cinfo = compact_for_llm(text, cfg)
    llm_stats.update(cinfo)
    # long inputs: split into focused chunks, queried in parallel (small models
    # lose recall in long noise). Normal pastes stay a single call.
    chunk_chars = cfg.get("chunk_chars", 4000)
    clines = compacted.split("\n")
    chunks, cur = [], []
    cur_len = 0
    for line in clines:
        if cur and cur_len + len(line) + 1 > chunk_chars:
            chunks.append("\n".join(cur))
            cur, cur_len = [], 0
        cur.append(line)
        cur_len += len(line) + 1
    if cur:
        chunks.append("\n".join(cur))
    llm_stats["chunks"] = len(chunks)
    prompts = [prompt_tmpl.replace("<<<TEXT>>>", c) for c in chunks]
    num_ctx = ctx_for(max(len(p) for p in prompts), cfg)
    llm_stats["num_ctx"] = num_ctx
    spans = []
    attempts = 0
    failed = False

    def run_one(prompt):
        for attempt in range(2):  # one retry with higher temperature
            try:
                return query_llm(prompt, model, base_temp + 0.2 * attempt, num_ctx,
                                 cfg["num_predict"], cfg["ollama_url"],
                                 cfg.get("keep_alive", "15m"), cfg.get("request_timeout", 150)), attempt + 1
            except Exception as ex:
                print("llm attempt %d failed (%s)" % (attempt + 1, ex), file=sys.stderr)
        return None, 2

    with concurrent.futures.ThreadPoolExecutor(max_workers=min(4, len(prompts))) as ex:
        results = list(ex.map(run_one, prompts))
    for res, att in results:
        attempts = max(attempts, att)
        if res is None:
            failed = True
        else:
            spans += res
    llm_stats["attempts"] = attempts
    llm_stats["model"] = model
    if failed and not spans:
        print("llm stage failed - continuing with deterministic results", file=sys.stderr)
        llm_stats["failed"] = True
        return []
    if failed:
        llm_stats["failed"] = True
    return match_spans(spans, text, taken, cfg, llm_stats)


def match_spans(spans, text, taken, cfg, llm_stats):
    """Match LLM-returned secrets against the full text. Returns repls list."""
    repls = []
    max_occ = cfg.get("max_occurrences", 10)
    for item in spans:
        if not isinstance(item, dict):
            continue
        secret = item.get("secret", "")
        label = item.get("label", "LLM") or "LLM"
        if not secret or len(secret) < 3:
            continue
        if vetoed(secret):
            continue
        matched = False
        for cand in secret_candidates(secret):
            if len(cand) < 3 or vetoed(cand):
                continue
            hits = []
            idx = 0
            while True:
                idx = text.find(cand, idx)
                if idx < 0:
                    break
                e = idx + len(cand)
                if not overlapping(taken, idx, e):
                    hits.append((idx, e))
                idx += 1
            if not hits:
                continue
            if len(hits) > max_occ:
                # a "secret" occurring that often is log noise, not a secret
                llm_stats.setdefault("capped", []).append(cand[:60])
                matched = True
                break
            for idx, e in hits:
                repls.append((idx, e, str(label)))
                taken.append((idx, e))
            matched = True
            break
        if not matched:
            llm_stats["unmatched"].append(secret[:60])
    return dedupe(repls)


def redact(text, cfg, strict=False):
    """Returns (redacted_text, applied, stats). applied entries hold label/tag/stage/original."""
    stats = {"strict": strict, "stages": {}, "timings": {},
             "llm": {"attempts": 0, "model": cfg["strict_model"] if strict else cfg["model"],
                     "failed": False, "unmatched": []}}
    t_all = time.perf_counter()
    text = normalize(text)
    if not text:
        stats["timings"]["total"] = 0.0
        return "", [], stats

    # custom regex first (fast, sync) - its tags are visible to the next stages
    taken = []
    t0 = time.perf_counter()
    c_repls = stage_custom(text, taken)
    stats["timings"]["custom"] = time.perf_counter() - t0
    text, c_applied = apply_all(text, c_repls, "regex")
    taken = tag_spans(text)
    applied = list(c_applied)
    stats["stages"]["regex"] = len(c_applied)

    # gitleaks and LLM overlap in wall-clock time on the same tagged text
    t0 = time.perf_counter()
    with concurrent.futures.ThreadPoolExecutor(max_workers=2) as ex:
        fg = ex.submit(stage_gitleaks, text, list(taken))
        fl = ex.submit(stage_llm, text, list(taken), cfg, strict, stats["llm"])
        g_repls = fg.result()
        l_repls = fl.result()
    stats["timings"]["detect_parallel"] = time.perf_counter() - t0

    g_repls = [(s, e, lb) for s, e, lb in g_repls if not overlapping(taken, s, e)]
    text, g_applied = apply_all(text, g_repls, "gitleaks")
    taken = tag_spans(text)
    applied += g_applied
    stats["stages"]["gitleaks"] = len(g_applied)

    l_repls = [(s, e, lb) for s, e, lb in l_repls if not overlapping(taken, s, e)]
    text, l_applied = apply_all(text, l_repls, "llm")
    taken = tag_spans(text)
    applied += l_applied
    stats["stages"]["llm"] = len(l_applied)
    stats["llm"]["passes"] = 1

    # second opinion: secrets were found AND untagged lines still talk about
    # credentials (small models drop findings when several secrets are present).
    # Full re-scan only pays off for single-chunk inputs; big inputs get the
    # cheaper micro-focus below instead.
    if (cfg.get("llm_second_pass", True) and stats["llm"].get("chunks", 1) == 1
            and (c_applied or g_applied or l_applied)):
        untagged = "\n".join(l for l in text.split("\n") if "[REDACTED_" not in l)
        if SUSPICIOUS_RX.search(untagged):
            t0 = time.perf_counter()
            l2 = stage_llm(text, list(taken), cfg, strict, stats["llm"], second=True)
            stats["timings"]["llm_pass2"] = time.perf_counter() - t0
            l2 = [(s, e, lb) for s, e, lb in l2 if not overlapping(taken, s, e)]
            text, l2_applied = apply_all(text, l2, "llm2")
            applied += l2_applied
            stats["stages"]["llm2"] = len(l2_applied)
            stats["llm"]["passes"] = 2

    # micro-focus: lines with MORE credential keywords than already-redacted
    # tags get their own tiny query each (measured: the model reliably flags a
    # secret in isolation that it drops inside long noise - including a second
    # secret sharing a line with the first). Handled spans are blanked (tags
    # get echoed, placeholder words get flagged - empty masks neither).
    # Capped, parallel, cheap.
    if cfg.get("llm_micro_focus", True):
        fulllines = text.split("\n")
        targets = []
        for i, l in enumerate(fulllines):
            stripped = TAG_RX.sub("", l)  # ignore keywords inside tags (BEARER/TOKEN/...)
            if len(SUSPICIOUS_RX.findall(stripped)) > len(TAG_RX.findall(l)):
                targets.append(i)
        targets = targets[:10]
        if targets:
            t0 = time.perf_counter()
            blanked = TAG_RX.sub("[hidden]", text).split("\n")
            micro_prompts = []
            for i in targets:
                win = blanked[max(0, i - 1):i + 2]
                micro_prompts.append(LLM_PROMPT_STRICT.replace("<<<TEXT>>>", "\n".join(win)))
            m_ctx = ctx_for(max(len(p) for p in micro_prompts), cfg)
            model = cfg["model"]

            def run_micro(prompt):
                try:
                    return query_llm(prompt, model, cfg.get("temperature", 0.2) + 0.1, m_ctx,
                                     cfg["num_predict"], cfg["ollama_url"],
                                     cfg.get("keep_alive", "15m"),
                                     cfg.get("request_timeout", 150))
                except Exception as ex:
                    print("llm micro query failed (%s)" % ex, file=sys.stderr)
                    return []

            with concurrent.futures.ThreadPoolExecutor(max_workers=min(4, len(micro_prompts))) as ex:
                m_results = list(ex.map(run_micro, micro_prompts))
            m_spans = []
            for r in m_results:
                if isinstance(r, list):
                    m_spans += r
            stats["llm"]["micro_queries"] = len(micro_prompts)
            taken = tag_spans(text)  # refresh: pass-2 tags included
            # NOTE: no post-filter here - match_spans already validated each
            # span against taken (filtering again would self-overlap and drop all)
            m_repls = match_spans(m_spans, text, taken, cfg, stats["llm"])
            text, m_applied = apply_all(text, m_repls, "llm-micro")
            taken = tag_spans(text)
            applied += m_applied
            stats["stages"]["llm-micro"] = len(m_applied)
            stats["timings"]["llm_micro"] = time.perf_counter() - t0

    stats["timings"]["total"] = time.perf_counter() - t_all
    return text, applied, stats


def summarize(applied, stats):
    counts = {}
    for a in applied:
        counts[a["label"]] = counts.get(a["label"], 0) + 1
    total = stats["timings"].get("total", 0.0)
    if not applied:
        summary = "clean (nothing redacted)"
        footer = "[paste-redact · clean · %.1fs]" % total
    else:
        labels = ", ".join(sorted(counts))
        summary = "%d replacement%s (%s)" % (
            len(applied), "" if len(applied) == 1 else "s",
            ", ".join("%s x%d" % (k, v) for k, v in sorted(counts.items())))
        footer = "[paste-redact · %d× redacted: %s · %s · %.1fs]" % (
            len(applied), labels, stats["llm"]["model"], total)
    return summary, footer, counts


def highlight(text):
    return TAG_RX.sub(lambda m: YEL + m.group(0) + RST, text)


def prompt_tty(question):
    try:
        with open("/dev/tty", "r") as tty:
            sys.stderr.write(question)
            sys.stderr.flush()
            return tty.readline().strip().lower()
    except OSError:
        return ""  # no terminal: accept


def run_preview(raw, cfg, strict=False):
    if not raw.strip():
        print("paste-redact: empty input", file=sys.stderr)
        return None, [], {"timings": {}}, 1
    real_stdout = sys.stdout
    sys.stdout = sys.stderr  # UI -> terminal; only the final text uses real stdout
    try:
        return _run_preview_ui(raw, cfg, strict)
    finally:
        sys.stdout = real_stdout


def _run_preview_ui(raw, cfg, strict=False):
    for rnd in (1, 2, 3):
        redacted, applied, stats = redact(raw, cfg, strict)
        summary, _footer, _counts = summarize(applied, stats)
        print("%s%spaste-redact Vorschau · Runde %d · %s%s" % (BOLD, CYAN, rnd, summary, RST))
        li = stats["llm"]
        saved = 1 - li.get("compact_chars", 1) / max(1, li.get("input_chars", 1))
        compact_note = (" · LLM-Input −%d%%" % round(saved * 100)) if saved > 0.05 else ""
        trunc_note = " · gekürzt" if li.get("truncated") else ""
        print("%s[%d Fundstellen, %.1fs, %s, ctx %d%s%s]%s" % (
            DIM, len(applied), stats["timings"].get("total", 0), li["model"],
            li.get("num_ctx", 0), compact_note, trunc_note, RST))
        print("=" * 64, file=sys.stderr)
        print(highlight(redacted).rstrip("\n"))
        print("=" * 64, file=sys.stderr)
        if applied:
            print("%sErsetzungen:%s" % (BOLD, RST))
            for i, a in enumerate(applied, 1):
                print("  %s#%d %s [%s]%s → %s%s%s" % (
                    DIM, i, a["label"], a["stage"], RST, RED, a["original"][:120], RST))
        else:
            print("%sKeine Secrets gefunden.%s" % (DIM, RST))
        choice = prompt_tty("[↵] Passt   [r] Retry (strenger)   [q] Abbrechen: ")
        if choice in ("", "y", "j", "p"):
            return redacted, applied, stats, 0
        if choice.startswith("r"):
            strict = True
            continue
        return None, applied, stats, 2
    return redacted, applied, stats, 0


def run_selftest(cfg):
    cfg = dict(cfg)
    cfg["temperature"] = 0.0  # deterministic: tests must not flake
    cfg["strict_temperature"] = 0.0
    # pure compaction checks (no LLM involved)
    dup = "line A\nline B\nline A\n\n\nline B\nline C\n"
    comp, info = compact_for_llm(dup, cfg)
    assert comp == "line A\nline B\n\nline C\n", repr(comp)
    assert info["dup_lines_removed"] == 2, info
    big = "secret BerrySecret123!\n" + "".join("noise filler line %d abcdef\n" % i for i in range(3000))
    comp, info = compact_for_llm(big, cfg)
    assert info["truncated"] and "omitted" in comp, info
    assert "secret BerrySecret123!" in comp  # head survives truncation
    # keyword line buried in the middle must survive (prose-secret recall)
    mid = "".join("filler %d\n" % i for i in range(500))
    mid += "the backup password is HiddenMid77!\n"
    mid += "".join("filler %d\n" % i for i in range(500, 1500))
    comp, info = compact_for_llm(mid, cfg)
    assert info["truncated"] and "HiddenMid77" in comp, info
    print("PASS compaction (dupes + truncation + keyword priority)")
    testdir = os.path.join(CFG_DIR, "tests")
    ok = True
    for name, expected in SELFTEST_CASES:
        with open(os.path.join(testdir, name)) as f:
            raw = f.read()
        t0 = time.perf_counter()
        _red, applied, _stats = redact(raw, cfg, strict=False)
        dt = time.perf_counter() - t0
        good = len(applied) == expected
        ok = ok and good
        print("%s %-28s expected %d, got %d (%.1fs)" % (
            "PASS" if good else "FAIL", name, expected, len(applied), dt))
    print("selftest: " + ("ALL PASS" if ok else "FAILURES"))
    return 0 if ok else 1


def main():
    args = sys.argv[1:]
    strict = "--strict" in args
    want_stats = "--stats" in args or "--auto" in args
    want_preview = "--preview" in args
    want_selftest = "--selftest" in args
    args = [a for a in args if a not in ("--strict", "--auto", "--preview", "--stats", "--selftest")]
    cfg = load_config()

    if want_selftest:
        sys.exit(run_selftest(cfg))

    report_path = None
    if "--report" in args:
        i = args.index("--report")
        report_path = args[i + 1]
        args = args[:i] + args[i + 2:]
    preview_out = None
    if "--preview-out" in args:
        i = args.index("--preview-out")
        preview_out = args[i + 1]
        args = args[:i] + args[i + 2:]

    if args and not args[0].startswith("-"):
        with open(args[0]) as f:
            raw = f.read()
    else:
        raw = sys.stdin.read()

    if want_preview:
        redacted, applied, stats, rc = run_preview(raw, cfg, strict)
        if redacted is None:
            print("paste-redact: preview ended without result", file=sys.stderr)
            sys.exit(rc)
        sys.stdout.write(redacted)
        summary, footer, _c = summarize(applied, stats)
        if report_path:
            write_report_json(report_path, summary, footer, applied, stats)
        print("paste-redact: " + summary, file=sys.stderr)
        sys.exit(rc)

    redacted, applied, stats = redact(raw, cfg, strict)
    summary, footer, _counts = summarize(applied, stats)
    out = redacted + ("\n" + footer + "\n" if want_stats and redacted else (footer + "\n" if want_stats else ""))

    if preview_out:
        with open(preview_out + ".redacted.txt", "w") as f:
            f.write(redacted)
        write_report_json(preview_out + ".report.json", summary, footer, applied, stats)
        print(preview_out, flush=True)
    else:
        sys.stdout.write(out)
    if report_path:
        write_report_json(report_path, summary, footer, applied, stats)
    print("paste-redact: " + summary, file=sys.stderr)


def write_report_json(path, summary, footer, applied, stats):
    with open(path, "w") as f:
        json.dump({"summary": summary, "footer": footer, "count": len(applied),
                   "replacements": [{"label": a["label"], "tag": a["tag"], "stage": a["stage"]}
                                    for a in applied],
                   "stats": stats}, f)


if __name__ == "__main__":
    main()
