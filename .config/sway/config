# Toggle keep-awake mode (Mod+Shift+T)
#bindsym $mod+Shift+t exec bash -c 'STATE_FILE=/tmp/sway_awake_state; if [ -f "$STATE_FILE" ]; then rm "$STATE_FILE"; pkill swayidle; swayidle -w timeout 600 "swaylock -f -c 000000" timeout 100 "swaymsg \"output * power off\"" resume "swaymsg \"output * power on\"" before-sleep "swaylock -f -c 000000" & disown; notify-send "Sleep Enabled" "Device will now auto-sleep again."; else touch "$STATE_FILE"; pkill swayidle; notify-send "Stay Awake Enabled" "Device will stay awake indefinitely."; fi'

bindsym $mod+s exec systemctl suspend
bindsym $mod+p exec nwg-displays

# Adaptive idle: 1min on battery / 5min on AC - managed by idle-manager.sh
# Mod+Shift+T still toggles stay-awake
exec_always --no-startup-id ~/.config/sway/scripts/idle-manager.sh
exec --no-startup-id ~/.config/sway/scripts/auto-brightness.sh
bindsym $mod+Shift+t exec bash -c 'STATE_FILE=/tmp/sway_awake_state; CACHE=/tmp/sway_idle_last_ac; if [ -f "$STATE_FILE" ]; then rm "$STATE_FILE"; rm -f "$CACHE"; notify-send "Sleep Enabled" "Resuming auto-sleep (1min battery / 5min AC)"; else touch "$STATE_FILE"; pkill swayidle; notify-send "Stay Awake Enabled" "Device will stay awake indefinitely."; fi'
# Gamma: sunset-auto (2500K Vienna manual) is now the default. Seed state at login so first Mod+Shift+N goes to Max.
exec --no-startup-id bash -c 'echo sunset > /tmp/gammastep_state; systemctl --user restart gammastep 2>/dev/null || (pkill -x gammastep 2>/dev/null; gammastep -m wayland & disown)'
bindsym $mod+Shift+n exec ~/.config/sway/scripts/gammastep-3way.sh # 3-way night mode: sunset (auto 2500K) -> max (1000K) -> off -> sunset ... [default: sunset]
bindsym $mod+Shift+b exec ~/.config/sway/scripts/auto-brightness.sh toggle  # auto-brightness on/off toggle

