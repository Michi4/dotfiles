exec export XDG_CURRENT_DESKTOP=sway && \
     systemctl --user import-environment DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP NO_AT_SPI_ADAPTER MOZ_ENABLE_WAYLAND && \
     dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP NO_AT_SPI_ADAPTER MOZ_ENABLE_WAYLAND && \
     systemctl --user start sway-session.target
# --- End of Initialization ---

