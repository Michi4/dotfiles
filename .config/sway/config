### Key bindings
#
# Basics:
#
    # Start a terminal
    bindsym $mod+t exec $term

    # Moch sofuat amoi an browser auf
    # na ned der browser an file browser (na no na ned)
    # i glaub i hob an schodn (betterhelp oda so)
    bindsym $mod+e exec thunar
    
    # steht in .profile
    #exec export XFCE_DISABLE_USER_SERVICES=1

    # Lockscreen
    bindsym $mod+l exec swaylock -c 000000
    bindswitch --locked lid:on exec swaylock -c 000000
    #bindsym $mod+shift+h exec sudo systemctl hibernate
    bindsym $mod+shift+h exec swaynag -t warning -m 'Do you really want to hibernate?' -B 'Yes, hibernate' 'sudo systemctl hibernate'

    # Media Controlls
    bindsym --locked XF86AudioRaiseVolume exec bash -c 'LAST=/tmp/volume_last; NOW=$(date +%s%3N); LAST_T=$(cat $LAST 2>/dev/null || echo 0); DIFF=$((NOW-LAST_T)); if [ $DIFF -lt 500 ]; then S=0.05; else S=0.1; fi; echo $NOW > $LAST; wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 1%+; for i in 2 3 4 5; do sleep $S; wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 1%+; done'
    bindsym --locked XF86AudioLowerVolume exec bash -c 'LAST=/tmp/volume_last; NOW=$(date +%s%3N); LAST_T=$(cat $LAST 2>/dev/null || echo 0); DIFF=$((NOW-LAST_T)); if [ $DIFF -lt 500 ]; then S=0.05; else S=0.1; fi; echo $NOW > $LAST; wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 1%-; for i in 2 3 4 5; do sleep $S; wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 1%-; done'
    bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
    bindsym --locked XF86AudioMicMute exec wpctl set-mute @DEFAULT_SOURCE@ toggle
    
    bindsym $mod+shift+l exec bash -c 'sleep 0.1; playerctl next'
    bindsym $mod+shift+j exec bash -c 'sleep 0.1; playerctl previous'
    bindsym $mod+shift+k exec bash -c 'sleep 0.1; playerctl play-pause'
    bindsym $mod+Shift+p exec bash -c 'sleep 0.1; playerctl play-pause'

    # Vesktop (Discord + Vencord)
    # Mute command (Right Ctrl + `)
    # Deafen command (Right Ctrl + ß)
    #bindsym Control_R+dead_acute exec ~/.vesktopCustomCommands/mute.sh
    #bindsym Control_R+ssharp exec ~/.vesktopCustomCommands/deafen.sh


    # --- SCREENSHOT SUITE ---

    # 1. Capture a region and edit (Arrows, Text, Blur) - The Flameshot Replacement
    bindsym $mod+Shift+s exec grim -g "$(slurp)" - | satty --filename - --output-filename ~/Screenshots/$(date +%Y%m%d-%H%M%S).png

    # 2. Capture a region and copy directly to clipboard (No editing, super fast)
    bindsym Print exec grim -g "$(slurp)" - | wl-copy && notify-send "Screenshot" "Region copied to clipboard"
    # 3. Capture the entire screen and save to file
    bindsym $mod+Print exec grim ~/Screenshots/$(date +%Y-%m-%d_%H-%m-%s).png && notify-send "Screenshot" "Full screen saved"
    # Screenshots Flameshot
    #bindsym $mod+shift+s exec flamseshot gui
    #bindsym $mod+Shift+s exec bash -c "QT_QPA_PLATFORM=wayland flameshot gui & disown"
    #bindsym $mod+shift+s exec QT_QPA_PLATFORM=wayland flameshot gui
    
    # Screen OCR | Text Extractor
    bindsym $mod+Shift+e exec grim -g "$(slurp)" - | tesseract -l deu+eng stdin stdout | tr -d '\f' | tr '\n' ' ' | sed 's/  */ /g' | sed 's/^ *//;s/ *$//' | wl-copy && notify-send "OCR Success" "Text cleaned and copied"

    # Copyq clipboard manager
    bindsym $mod+v exec copyq toggle

    for_window [app_id="copyq"] floating enable
    for_window [app_id="pavucontrol"] floating enable
    for_window [app_id="qalculate-gtk"] floating enable
    for_window [app_id="nwg-displays"] floating enable

    #bindgesture scroll:3:up   exec volumectl +1%
    #bindgesture scroll:3:down exec volumectl -1%

    # Kill focused window
    bindsym $mod+Shift+q kill

    # Start your launcher
    bindsym $mod+d exec $menu
    bindsym Mod1+space exec $menu

    # Drag floating windows by holding down $mod and left mouse button.
    # Resize them with right mouse button + $mod.
    # Despite the name, also works for non-floating windows.
    # Change normal to inverse to use left mouse button for resizing and right
    # mouse button for dragging.
    floating_modifier $mod normal

    # Reload the configuration file
    bindsym $mod+Shift+c reload

    # Exit sway (logs you out of your Wayland session)
    bindsym $mod+Shift+Escape exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'
