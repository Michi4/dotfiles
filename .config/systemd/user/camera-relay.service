[Unit]
Description=Relay IPU6 camera to /dev/video97 for legacy V4L2 apps
After=pipewire.service
Wants=pipewire.service

[Service]
Type=simple
ExecStart=/usr/bin/gst-launch-1.0 -e libcamerasrc ! queue ! videoconvert ! videoscale ! video/x-raw,width=1280,height=720,framerate=30/1 ! queue ! v4l2sink device=/dev/video97 sync=false
Restart=on-failure
RestartSec=3
Nice=10

[Install]
WantedBy=default.target
